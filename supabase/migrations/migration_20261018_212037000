-- Voltar para Grátis: grava a ação no histórico com motivo automático.
create or replace function public.admin_set_free(
  p_user_id uuid, p_reason text
)
returns void
language plpgsql
security definer
set search_path = public
as $$
declare
  admin_mail text;
begin
  if not public.is_admin() then
    raise exception 'not authorized';
  end if;

  select email into admin_mail from public.profiles where id = auth.uid();

  update public.profiles
     set plan = 'free', premium_until = null
   where id = p_user_id;

  insert into public.premium_grants (user_id, dias, motivo, admin_email)
  values (p_user_id, 0, coalesce(nullif(p_reason, ''), 'Voltou para Grátis'), admin_mail);
end;
$$;

-- Zerar teste grátis.
create or replace function public.admin_reset_trial(
  p_user_id uuid, p_reason text
)
returns void
language plpgsql
security definer
set search_path = public
as $$
declare
  admin_mail text;
begin
  if not public.is_admin() then
    raise exception 'not authorized';
  end if;

  select email into admin_mail from public.profiles where id = auth.uid();

  update public.profiles
